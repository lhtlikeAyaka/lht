# Arduino is initialized explicitly by main/app_main.cpp.
# This avoids relying on the Arduino component's optional app_main autostart.
CONFIG_AUTOSTART_ARDUINO=n
CONFIG_FREERTOS_HZ=1000

# ESP32-S3-N16R8: 16 MB flash + 8 MB OPI PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y

# Custom table includes two 3 MB OTA slots and the ESP-SR model partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/voiceassistant_multinet.csv"

# Pre-trained Chinese MultiNet 6 model, paired with its FST graph.
CONFIG_SR_MN_CN_MULTINET6_QUANT=y

# Enable the PSK modes menu and its symmetric PSK key exchange for Arduino TLS.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
